# YOUR MOVE — environment variables
# Copy to `.env.local` (Next.js) and set the same values in Vercel.
# Do NOT commit real values, and do not paste the service-role key anywhere public —
# it bypasses row-level security completely.

# --- Supabase ---
# Project Settings → Data API → Project URL
YOURMOVE_SUPABASE_URL=
# Project Settings → API Keys → anon / public  (newer projects: "publishable")
YOURMOVE_SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role  (newer projects: "secret"). SERVER ONLY.
YOURMOVE_SUPABASE_SERVICE_ROLE=

# Only needed once a phase subscribes to Realtime in the browser. V1A does not.
# NEXT_PUBLIC_YOURMOVE_SUPABASE_URL=
# NEXT_PUBLIC_YOURMOVE_SUPABASE_ANON_KEY=

# --- The facilitator console ---
# Guards /yourmove/console — the only surface that can apply the twelve-measurement
# leadership overlay. Any long random string: `openssl rand -hex 24`.
# UNSET MEANS CLOSED, not open.
YOURMOVE_CONSOLE_SECRET=

# --- Models ---
# Without a key the world still runs: stage 1 falls back to the deterministic parser and
# stage 5 to the deterministic renderer. The rules are identical; only the prose changes.
ANTHROPIC_API_KEY=
# YOURMOVE_INTENT_MODEL=claude-haiku-4-5-20251001
# YOURMOVE_NARRATOR_MODEL=claude-sonnet-5
